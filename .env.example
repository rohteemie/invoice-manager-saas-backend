DB_HOST=database host here
DB_PWD=database password here
DB_PORT=database port here
DB_USER=database user here
DB_NAME=database here

DB_TYPE=mysql or postgresql
DATABASE_URL=mysql+pymysql://$DB_USER:$DB_PWD@$DB_HOST:$DB_PORT/$DB_NAME

ACCESS_TOKEN_EXPIRATION=30  # in minutes
SECRET_KEY=your secret key here

PROJECT_NAME=Multi-Tenant SaaS Backend

# CORS Configuration
# IMPORTANT: For production, specify exact allowed origins instead of using ["*"]
# The wildcard ["*"] allows all origins and is only suitable for development/testing
# Production example: CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]
# Development default: CORS_ORIGINS=["*"]
CORS_ORIGINS=["*"]

# Email Verification Configuration
# Base URL for email verification links (frontend URL)
# Development: http://localhost:3000
# Production: https://yourapp.com

SENDGRID_API_KEY="your-sendgrid-api-key-here"
EMAILS_FROM=noreply@yourapp.com
EMAIL_VERIFICATION_BASE_URL=http://localhost:5173

# Token expiration time in hours (default: 24 hours)
EMAIL_VERIFICATION_TOKEN_EXPIRATION_HOURS=24

# Password reset token expiration in minutes (default: 30 minutes)
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

# Progressive Login Delay Settings (OWASP ASVS & NIST 800-63B Compliance)
# Delays are applied progressively based on failed login attempts per account
# Short delay for 4-5 failed attempts (seconds)
LOGIN_DELAY_SHORT=2
# Medium delay for 6-8 failed attempts (seconds)
LOGIN_DELAY_MEDIUM=30
# Long delay/cooldown for 9+ failed attempts (seconds, 900 = 15 minutes)
LOGIN_DELAY_LONG=900
# Thresholds for when each delay level kicks in
LOGIN_DELAY_THRESHOLD_SHORT=4
LOGIN_DELAY_THRESHOLD_MEDIUM=6
LOGIN_DELAY_THRESHOLD_LONG=9
# Time window for tracking failures (seconds, 3600 = 1 hour)
LOGIN_FAILURE_WINDOW=3600
